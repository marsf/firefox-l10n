moz-box-link-anchor =
    .title = نویں ٹیب اچ کھلدے
moz-box-link-opens-in-new-tab = نویں ٹیب وچ کھلدا ہے
moz-box-item-reorder-handle =
    .aria-label = Ctrl+Shift+ArrowUp یا Ctrl+Shift+ArrowDown ورت کے آئٹم کوں دوبارہ ترتیب ݙیو
# Variables:
#   $item (string) - The label of the moz-box-item being reordered.
moz-box-item-reorder-handle-named =
    .aria-label = Ctrl+Shift+ArrowUp یا Ctrl+Shift+ArrowDown ورت کے { $item } کوں دوبارہ ترتیب ݙیو

## Screen reader announcements made after an item in a reorderable list is moved.
## Variables:
##   $position (number) - The new position of the item in the list, starting at 1.
##   $total (number) - The total number of items in the list.

moz-box-group-reorder-announcement = شے { $total } وچوں { $position } نمبر پوزیشن تے منتقل تھی ڳئی۔
